{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // Builds with CMake/Ninja, then debugs the console app. The
      // integrated terminal is used so commands can be typed on stdin
      // and "initialize" can find config.txt (cwd is the workspace root).
      "name": "Debug csopesy_mo1 (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/csopesy_mo1.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/w64devkit/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Use Intel disassembly syntax",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build"
    },
    {
      // Same build and program, but without attaching the debugger.
      "name": "Run csopesy_mo1 (no debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/csopesy_mo1.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "console": "integratedTerminal",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/w64devkit/bin/gdb.exe",
      "noDebug": true,
      "preLaunchTask": "build"
    }
  ]
}
