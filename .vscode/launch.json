{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CMake Target",
      "type": "cppdbg",
      "request": "launch",
      // ${command:cmake.launchTargetPath} automatically resolves the built executable
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/mo4",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb", // Use "lldb" on macOS or "gdb" on Linux/MinGW
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      // Builds the target automatically before running
      "preLaunchTask": "CMake: build"
    }
  ]
}
